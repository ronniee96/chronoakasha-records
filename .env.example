# ==============================================================================
# CHRONOAKASHA RECORDS — OBSERVATORY DATA PROVIDER CONFIGURATION
# Server-Side Only: Never prefix secrets with NEXT_PUBLIC_
# ==============================================================================

# 1. NASA OPEN APIs (https://api.nasa.gov/)
# Register free key at api.nasa.gov (fallback to DEMO_KEY if blank)
NASA_API_KEY=DEMO_KEY

# 2. COPERNICUS DATA SPACE / SENTINEL HUB (https://dataspace.copernicus.eu/)
# OAuth client credentials for Sentinel-1 (Radar) & Sentinel-2 (Optical)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# 3. SPACE-TRACK (https://www.space-track.org/)
# Authenticated account for GP_History archival 7-day orbital element replay
SPACETRACK_USERNAME=
SPACETRACK_PASSWORD=

# 4. DATABASE (PostgreSQL / Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chronoakasha?schema=public
